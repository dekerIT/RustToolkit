<Window x:Class="RustToolkit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RustToolkit"
        Icon="pack://application:,,,/Assets/RustToolkit.ico"
        Width="1120"
        Height="760"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="NavigationPanel"
                Grid.Column="0"
                Background="{StaticResource NavigationBackground}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="14">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,7,4,24">
                        <Border Width="38"
                                Height="38"
                                CornerRadius="10"
                                Background="Transparent">
                            <Image Source="pack://application:,,,/Assets/RustToolkit.png"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="RUSTTOOLKIT"
                                       FontFamily="Cascadia Code"
                                       FontSize="12"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="DESKTOP FIELD KIT"
                                       FontFamily="Cascadia Code"
                                       FontSize="8"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="4,0,4,18" />
                    <TextBlock Text="TOOLKIT"
                               FontFamily="Cascadia Code"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="10,0,0,9" />
                    <ToggleButton x:Name="AlarmNavigationButton"
                                  Content="01   Raid Alarm"
                                  Style="{StaticResource SidebarNavigationStyle}"
                                  Margin="0,0,0,4"
                                  Click="ShowAlarmPage_Click" />
                    <ToggleButton x:Name="TimersNavigationButton"
                                  Content="02   Timers"
                                  Style="{StaticResource SidebarNavigationStyle}"
                                  Margin="0,0,0,4"
                                  Click="ShowTimersPage_Click" />
                    <ToggleButton x:Name="CraftingNavigationButton"
                                  Content="03   Crafting"
                                  Style="{StaticResource SidebarNavigationStyle}"
                                  Margin="0,0,0,4"
                                  Click="ShowCraftingPage_Click" />
                    <ToggleButton x:Name="RustPlusNavigationButton"
                                  Content="04   Rust+"
                                  Style="{StaticResource SidebarNavigationStyle}"
                                  Margin="0,0,0,4"
                                  Click="ShowRustPlusPage_Click" />
                    <ToggleButton x:Name="RaidPlannerNavigationButton"
                                  Content="05   Raid Planner"
                                  Style="{StaticResource SidebarNavigationStyle}"
                                  Margin="0,0,0,4"
                                  Click="ShowRaidPlannerPage_Click" />
                    <ToggleButton x:Name="SettingsNavigationButton"
                                  Content="06   Settings"
                                  Style="{StaticResource SidebarNavigationStyle}"
                                  Click="ShowSettingsPage_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,18,4,4">
                    <Border Height="1"
                            Background="{StaticResource PanelBorderBrush}"
                            Margin="0,0,0,12" />
                    <TextBlock Text="WINDOWS  /  LOCAL TOOLS"
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="Cascadia Code"
                               FontSize="8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Padding="34,30">
            <ContentControl x:Name="PageHost" />
        </Border>
    </Grid>
</Window>
