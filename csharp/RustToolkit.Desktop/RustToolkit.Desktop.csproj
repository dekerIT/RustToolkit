<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>..\..\assets\RustToolkit.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\RustToolkit.ico">
      <Link>Assets\RustToolkit.ico</Link>
    </Resource>
    <Content Include="..\..\assets\local notes\notes.exe">
      <Link>notes\notes.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RustPlusApi" Version="2.0.0-beta.10" />
    <PackageReference Include="RustPlusApi.Fcm" Version="2.0.0-beta.10" />
    <PackageReference Include="RustPlusApi.Fcm.Registration" Version="2.0.0-beta.10" />
  </ItemGroup>

</Project>
