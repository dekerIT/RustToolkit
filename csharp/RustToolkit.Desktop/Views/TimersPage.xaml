<UserControl x:Class="RustToolkit.Desktop.Views.TimersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Timers" FontSize="29" FontWeight="Bold" />
            <TextBlock Text="Named countdowns are saved locally and resume when the app restarts."
                       Foreground="{StaticResource MutedBrush}"
                       Margin="0,7,0,0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TimerNameBox"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Timer name" />
                <TextBox x:Name="MinutesBox"
                         Grid.Column="1"
                         Text="30"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Duration in minutes" />
                <Button Grid.Column="2"
                        Content="Add Timer"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="AddTimer_Click" />
            </Grid>
        </Border>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="4"
                   Foreground="{StaticResource ErrorBrush}"
                   Visibility="Collapsed" />

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="TimerList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelBackground}"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding RemainingText}"
                                           VerticalAlignment="Center"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,18,0" />
                                <Button Grid.Column="2"
                                        Content="Cancel"
                                        Tag="{Binding Id}"
                                        VerticalAlignment="Center"
                                        Click="RemoveTimer_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
