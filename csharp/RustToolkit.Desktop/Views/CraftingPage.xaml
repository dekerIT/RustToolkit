<UserControl x:Class="RustToolkit.Desktop.Views.CraftingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="{StaticResource AppBackground}"
             Loaded="CraftingPage_Loaded">
    <UserControl.Resources>
        <DataTemplate x:Key="RustHelpSectionTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="{Binding Description}"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="2,0,2,8" />
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource PanelRaised}"
                                        BorderBrush="{StaticResource PanelBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="36"
                                                Height="36"
                                                Background="{StaticResource PanelBackground}"
                                                CornerRadius="6"
                                                VerticalAlignment="Top">
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontFamily="Cascadia Code"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Cells}" Margin="0,6,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{StaticResource PanelBackground}"
                                                                CornerRadius="6"
                                                                Padding="7"
                                                                Margin="0,0,0,5">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold" />
                                                                <TextBlock Text="{Binding Text}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                                <ItemsControl ItemsSource="{Binding Entries}" Margin="0,5,0,0">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="{StaticResource PanelRaised}"
                                                                                    CornerRadius="5"
                                                                                    Padding="5"
                                                                                    Margin="0,0,5,5">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <Border Width="26"
                                                                                            Height="26"
                                                                                            Background="{StaticResource PanelBackground}"
                                                                                            CornerRadius="4">
                                                                                        <Grid>
                                                                                            <TextBlock Text="{Binding Initials}"
                                                                                                       FontSize="8"
                                                                                                       Foreground="{StaticResource MutedBrush}"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center" />
                                                                                            <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                                                                                        </Grid>
                                                                                    </Border>
                                                                                    <StackPanel VerticalAlignment="Center" Margin="5,0,0,0">
                                                                                        <TextBlock Text="{Binding Name}"
                                                                                                   FontSize="11"
                                                                                                   TextTrimming="CharacterEllipsis"
                                                                                                   MaxWidth="150" />
                                                                                        <TextBlock Text="{Binding Quantity}"
                                                                                                   Foreground="{StaticResource AccentBrush}"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="SemiBold" />
                                                                                    </StackPanel>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate x:Key="CraftingItemTemplate">
            <Border Padding="5" Margin="0,0,0,4" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" Background="{StaticResource PanelRaised}" CornerRadius="5">
                        <Grid>
                            <TextBlock Text="{Binding Initials}"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontFamily="Cascadia Code"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            <Image Source="{Binding Item.IconUrl}" Stretch="Uniform" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="{Binding Item.DisplayName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Item.ShortName}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{Binding FavoriteGlyph}"
                            ToolTip="{Binding FavoriteToolTip}"
                            Foreground="{StaticResource AccentBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="20"
                            Focusable="False"
                            Click="FavoriteButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Crafting &amp; Item Search" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Search Rust items for recipes, research costs, and listed loot sources."
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Content="Refresh item data"
                        Click="RefreshButton_Click" />
                <TextBlock x:Name="DataStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           MaxWidth="300"
                           Margin="0,7,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="SEARCH ITEMS"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               FontWeight="Bold"
                               Margin="4,0,4,6" />
                    <TextBox x:Name="SearchBox"
                             Grid.Row="1"
                             VerticalContentAlignment="Center"
                             ToolTip="Search by item name or shortname"
                             TextChanged="SearchBox_TextChanged" />
                    <TabControl Grid.Row="2" Margin="0,10,0,0">
                        <TabItem Header="Items">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SearchResultsText"
                                           Text="ITEMS"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="4,8,4,10" />
                                <ListBox x:Name="ItemList"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{StaticResource TextPrimaryBrush}"
                                         ItemTemplate="{StaticResource CraftingItemTemplate}"
                                         SelectionChanged="ItemList_SelectionChanged" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Favorites">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FavoriteStatusText"
                                           Text="FAVORITES"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="4,8,4,10" />
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="FavoriteList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimaryBrush}"
                                             ItemTemplate="{StaticResource CraftingItemTemplate}"
                                             SelectionChanged="ItemList_SelectionChanged" />
                                    <TextBlock x:Name="FavoriteEmptyText"
                                               Text="Star an item to add it to Favorites."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="12"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" MinHeight="180" />
                    <RowDefinition Height="2*" MinHeight="150" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" Background="{StaticResource PanelRaised}" CornerRadius="8">
                            <Grid>
                                <TextBlock x:Name="SelectedItemGlyph"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontFamily="Cascadia Code"
                                           FontSize="19"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                                <Image x:Name="SelectedItemImage" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="SelectedItemName"
                                       Text="Select an item"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedItemDetails"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                            <TextBlock x:Name="SelectedItemDescription"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       MaxHeight="44" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,10,0,10">
                    <TabControl x:Name="ItemDetailsTabs" />
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="3,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="RECIPE INGREDIENTS"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <TextBlock Text="AMOUNT"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0" />
                                        <TextBox x:Name="QuantityBox"
                                                 Width="76"
                                                 Text="1"
                                                 VerticalContentAlignment="Center"
                                                 Margin="0,0,8,0"
                                                 ToolTip="Desired quantity" />
                                        <Button x:Name="CalculateButton"
                                                Content="Calculate"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                IsEnabled="False"
                                                Padding="12,8"
                                                Click="CalculateButton_Click" />
                                    </StackPanel>
                        </Grid>
                        <TextBlock x:Name="CalculationSummary"
                                   Text="Choose an item and calculate its materials."
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="3,0,0,8" />
                        <TextBlock x:Name="CalculationWorkbenchText"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap"
                                   Margin="3,0,0,8" />
                        <ItemsControl x:Name="CraftStepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBackground}"
                                            CornerRadius="7"
                                            Padding="10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30"
                                                    Height="30"
                                                    Background="{StaticResource PanelRaised}"
                                                    CornerRadius="5"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding IndentedName}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding WorkbenchText}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding BatchText}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="TOTAL MATERIALS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="3,10,0,8" />
                        <TextBlock x:Name="MaterialsSourceText"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   TextWrapping="Wrap"
                                   Margin="3,0,0,8" />
                        <ItemsControl x:Name="MaterialsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBackground}"
                                            CornerRadius="7"
                                            Padding="9"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="26"
                                                    Height="26"
                                                    Background="{StaticResource PanelRaised}"
                                                    CornerRadius="4"
                                                    VerticalAlignment="Center">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initials}"
                                                               FontSize="8"
                                                               Foreground="{StaticResource MutedBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AmountText}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="3"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />
        <wv2:WebView2 x:Name="RustHelpBrowser"
                      Width="1"
                      Height="1"
                      Visibility="Hidden"
                      IsHitTestVisible="False" />
    </Grid>
</UserControl>
