<UserControl x:Class="RustToolkit.Desktop.Views.CraftingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}"
             Loaded="CraftingPage_Loaded">
    <UserControl.Resources>
        <DataTemplate x:Key="CraftingItemTemplate">
            <Border Padding="5" Margin="0,0,0,4" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <Border Width="36" Height="36" Background="#252D36" CornerRadius="5">
                        <Image Source="{Binding Icon}" Width="32" Height="32" Stretch="Uniform" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                        <TextBlock Text="{Binding Item.DisplayName}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Item.CategoryName}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{Binding FavoriteGlyph}"
                            ToolTip="{Binding FavoriteToolTip}"
                            Foreground="#FFC857"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0"
                            FontSize="20"
                            Focusable="False"
                            Click="FavoriteButton_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Crafting Calculator" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Choose an item and amount to see the full ingredient breakdown."
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Content="Refresh recipes"
                        Click="RefreshButton_Click" />
                <TextBlock x:Name="DataStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Right"
                           MaxWidth="300"
                           Margin="0,7,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Search items by name"
                         TextChanged="SearchBox_TextChanged" />
                <TextBox x:Name="QuantityBox"
                         Grid.Column="1"
                         Text="1"
                         VerticalContentAlignment="Center"
                         Margin="0,0,10,0"
                         ToolTip="Desired quantity" />
                <Button Grid.Column="2"
                        Content="Calculate"
                        Background="{StaticResource AccentBrush}"
                        Click="CalculateButton_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="12">
                <Grid>
                    <TabControl>
                        <TabItem Header="Items">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SearchResultsText"
                                           Text="CRAFTABLE ITEMS"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="4,8,4,10" />
                                <ListBox x:Name="ItemList"
                                         Grid.Row="1"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="#F4F6F8"
                                         ItemTemplate="{StaticResource CraftingItemTemplate}"
                                         SelectionChanged="ItemList_SelectionChanged" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Favorites">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="FavoriteStatusText"
                                           Text="FAVORITES"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Margin="4,8,4,10" />
                                <Grid Grid.Row="1">
                                    <ListBox x:Name="FavoriteList"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#F4F6F8"
                                             ItemTemplate="{StaticResource CraftingItemTemplate}"
                                             SelectionChanged="ItemList_SelectionChanged" />
                                    <TextBlock x:Name="FavoriteEmptyText"
                                               Text="Star an item to add it to Favorites."
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="12"
                                               IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="64" Height="64" Background="#252D36" CornerRadius="8">
                            <Image x:Name="SelectedItemImage"
                                   Width="58"
                                   Height="58"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock x:Name="SelectedItemName"
                                       Text="Select an item"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="SelectedItemDetails"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Background="{StaticResource PanelBackground}"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,10,0,10">
                    <StackPanel>
                        <TextBlock x:Name="CalculationSummary"
                                   Text="Choose an item and calculate its materials."
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="WorkbenchText"
                                   Foreground="{StaticResource MutedBrush}"
                                   Margin="0,5,0,0" />
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="CRAFTING BREAKDOWN"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="3,0,0,8" />
                        <ItemsControl x:Name="CraftStepsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBackground}"
                                            CornerRadius="7"
                                            Padding="10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding IndentedName}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding WorkbenchText}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="11"
                                                           Margin="0,3,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding BatchText}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="TOTAL BASE MATERIALS"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Margin="3,10,0,8" />
                        <ItemsControl x:Name="MaterialsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelBackground}"
                                            CornerRadius="7"
                                            Padding="9"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="38" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="32" Height="32" Background="#252D36" CornerRadius="5">
                                                <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" />
                                            </Border>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Material.DisplayName}"
                                                       VerticalAlignment="Center"
                                                       Margin="9,0,0,0" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AmountText}"
                                                       VerticalAlignment="Center"
                                                       FontWeight="SemiBold"
                                                       Margin="10,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="5"
                   Foreground="#F08A78"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
