<UserControl x:Class="RustToolkit.Desktop.Views.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}"
             Loaded="WelcomePage_Loaded">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="WelcomeContent"
                        MaxWidth="760"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0">
                <StackPanel.RenderTransform>
                    <TranslateTransform Y="14" />
                </StackPanel.RenderTransform>
                <TextBlock Text="Welcome to RustToolkit"
                           FontSize="32"
                           FontWeight="Bold" />
                <TextBlock Text="Connect Rust+ now, or explore the local tools first. Steam sign-in is optional."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="15"
                           TextWrapping="Wrap"
                           Margin="0,8,0,22" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <TextBlock Text="AVAILABLE WITHOUT SIGN-IN"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Raid siren test&#10;Countdown timers&#10;Crafting calculator&#10;Keep-awake and app settings"
                                       TextWrapping="Wrap"
                                       LineHeight="26"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2"
                            Background="{StaticResource PanelBackground}"
                            CornerRadius="10"
                            Padding="18">
                        <StackPanel>
                            <TextBlock Text="UNLOCKED WITH RUST+"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="Real Smart Alarm notifications&#10;Paired server map&#10;Paired smart devices"
                                       TextWrapping="Wrap"
                                       LineHeight="26"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                    <Button Content="Connect Steam / Rust+"
                            Background="{StaticResource AccentBrush}"
                            Click="Connect_Click" />
                    <Button Content="I'll sign in later — continue"
                            Margin="10,0,0,0"
                            Click="Continue_Click" />
                </StackPanel>
                <TextBlock Text="You can connect later from the Rust+ page. No account is needed for the local tools."
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
