<UserControl x:Class="RustToolkit.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">
    <StackPanel>
        <TextBlock Text="Settings" FontSize="29" FontWeight="Bold" />
        <TextBlock Text="Application behavior"
                   Foreground="{StaticResource MutedBrush}"
                   Margin="0,7,0,20" />

        <Border Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="18">
            <StackPanel>
                <CheckBox x:Name="StartupCheckBox"
                          Content="Start RustToolkit with Windows"
                          Foreground="#F4F6F8"
                          FontSize="14"
                          Checked="StartupCheckBox_Changed"
                          Unchecked="StartupCheckBox_Changed" />
                <CheckBox x:Name="KeepAwakeCheckBox"
                          Content="Keep the PC awake while RustToolkit is running"
                          Foreground="#F4F6F8"
                          FontSize="14"
                          Margin="0,14,0,0"
                          Checked="KeepAwakeCheckBox_Changed"
                          Unchecked="KeepAwakeCheckBox_Changed" />
                <TextBlock Text="The app minimizes to the system tray when its window is closed."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0" />
                <TextBlock Text="Prevents Windows from putting the PC to sleep; it does not keep the display on. The setting is active until you exit RustToolkit."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
