<UserControl x:Class="RustToolkit.Desktop.Views.RaidPlannerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}"
             Loaded="RaidPlannerPage_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="10" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Raid Planner" FontSize="29" FontWeight="Bold" />
                <TextBlock Text="Compare cost and time, then subtract explosives already in your inventory."
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,7,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button x:Name="RefreshButton"
                        Content="Refresh raid data"
                        Click="RefreshButton_Click" />
                <TextBlock x:Name="SourceStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="260"
                           Margin="0,6,0,0" />
                <TextBlock x:Name="ItemIconStatusText"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           TextAlignment="Right"
                           TextWrapping="Wrap"
                           MaxWidth="260"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource PanelBackground}" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="105" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TARGET" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <ComboBox x:Name="TargetComboBox"
                              MinHeight="36"
                              Background="{StaticResource PanelRaised}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              BorderBrush="{StaticResource PanelBorderBrush}"
                              DisplayMemberPath="Name"
                              SelectionChanged="TargetComboBox_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="TARGETS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="TargetCountBox"
                             Text="1"
                             VerticalContentAlignment="Center"
                             TextChanged="Inputs_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="CURRENT HP" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBox x:Name="CurrentHealthBox"
                             Text="0"
                             VerticalContentAlignment="Center"
                             TextChanged="Inputs_TextChanged" />
                </StackPanel>
                <CheckBox x:Name="SoftSideCheckBox"
                          Grid.Column="6"
                          Content="Soft side"
                          VerticalAlignment="Bottom"
                          Margin="0,0,0,9"
                          Visibility="Collapsed"
                          Click="SoftSideCheckBox_Click" />
            </Grid>
        </Border>

        <Expander Grid.Row="4"
                  Header="How these estimates work"
                  Foreground="{StaticResource MutedBrush}"
                  Margin="2,0,0,0">
            <Border Background="{StaticResource PanelBackground}" CornerRadius="8" Padding="12">
                <TextBlock Text="Rustly provides full-health explosive counts, not damage per hit. Custom HP, inventory use, remaining HP, and material cost are estimated by scaling those counts; overkill and random damage can change the result."
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </Expander>

        <Grid Grid.Row="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Background="{StaticResource PanelRaised}" CornerRadius="6">
                    <Grid>
                        <TextBlock x:Name="SelectedTargetGlyph"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <Image x:Name="SelectedTargetImage" Stretch="Uniform" />
                    </Grid>
                </Border>
                <TextBlock x:Name="PlanSummaryText"
                           Grid.Column="1"
                           Text="Choose a target to load the Rustly raid plan."
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button x:Name="OpenSourceButton"
                        Grid.Column="2"
                        Content="Rustly API docs"
                        Padding="10,6"
                        Click="OpenSourceButton_Click"
                        IsEnabled="False"
                        Margin="8,0,0,0" />
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                <ItemsControl x:Name="MethodsList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource PanelBackground}"
                                    CornerRadius="8"
                                    Padding="13"
                                    Margin="0,0,0,7">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="9" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="5" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40"
                                                Height="40"
                                                Background="{StaticResource PanelRaised}"
                                                CornerRadius="6">
                                            <Grid>
                                                <TextBlock Text="{Binding Initials}"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding IconUrl}" Stretch="Uniform" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       FontSize="14"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="Raid method"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Badges}"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="9" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="REQUIRED" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock Text="{Binding RequiredText}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="7" Margin="0,0,6,0">
                                            <StackPanel>
                                                <TextBlock Text="YOU HAVE" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                            <TextBox Text="{Binding OwnedText, UpdateSourceTrigger=PropertyChanged}"
                                                     VerticalContentAlignment="Center"
                                                     Padding="7,4"
                                                     FontSize="12"
                                                     TextChanged="OwnedCountBox_TextChanged"
                                                     ToolTip="Enter how many of this explosive you already have" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="9">
                                            <StackPanel>
                                                <TextBlock Text="TO BRING / CRAFT" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock Text="{Binding BringText}" FontSize="17" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="7" Margin="0,0,5,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" Background="{StaticResource PanelBackground}" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock Text="S" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding SulfurIconUrl}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Sulfur" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                    <TextBlock Text="{Binding SulfurText}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="1" Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="7" Margin="0,0,5,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" Background="{StaticResource PanelBackground}" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock Text="C" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding CharcoalIconUrl}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Charcoal" Foreground="{StaticResource MutedBrush}" FontSize="9" />
                                                    <TextBlock Text="{Binding CharcoalText}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="2" Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="7" Margin="0,0,5,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="26" Height="26" Background="{StaticResource PanelBackground}" CornerRadius="4">
                                                    <Grid>
                                                        <TextBlock Text="M" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Image Source="{Binding MetalFragmentsIconUrl}" Stretch="Uniform" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="Metal fragments" Foreground="{StaticResource MutedBrush}" FontSize="9" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding MetalFragmentsText}" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Grid.Column="3" Background="{StaticResource PanelRaised}" CornerRadius="6" Padding="9">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="EST. TIME" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="Bold" />
                                                <TextBlock Text="{Binding TimeText}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="6"
                                               Text="{Binding EstimateFootnote}"
                                               Foreground="{StaticResource MutedBrush}"
                                               FontSize="10"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="7"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
